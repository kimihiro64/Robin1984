/-!
## Provenance

- Classification: **Standard mathematical formalization**.
- Mathematical source: Strong approximation for the special linear group using elementary matrices and compactness of the norm-one idele class group.
- Formalization note: Constructs integral representatives in the determinant-one finite matrix group and a compact set of finite projections meeting every rational orbit of the determinant-norm-one adelic group.
- PROVENANCE-END
-/

/-!
# Reduction of finite adelic matrix coordinates

A finite-adelic transvection is a limit of principal transvections
by additive strong approximation. At a finite set of exceptional
places the local determinant-one groups are generated by those
transvections. The integral subgroup is open, so its cosets meeting
the closure of the principal group meet the group itself.

The compact norm-one idele class group supplies the determinant
representatives. Removing the determinant in one diagonal position
then reduces the remaining finite coordinates into the integral
matrix subgroup.
-/

set_option autoImplicit false

namespace Robin1984.GRH

variable {I R : Type*} [Fintype I] [DecidableEq I] [CommRing R]

/-- Opposite unit scalars in two diagonal positions give four elementary
row operations, without any field hypothesis on the coefficient ring. -/
theorem diagonal_pair_eq_transvections (i j : I) (hij : Not (i = j))
    (a b : R) (hab : a * b = 1) :
    Matrix.diagonal (fun k => if k = i then a else if k = j then b else 1) =
      Matrix.transvection i j (a - 1) *
        (Matrix.transvection j i 1 *
          (Matrix.transvection i j (b - 1) * Matrix.transvection j i (-a))) := by
  have h1 : 1 + -((b - 1) * a) = a := by
    calc
      _ = a + (1 - a * b) := by ring
      _ = a := by rw [hab, sub_self, add_zero]
  have h2 : 1 + (b - 1) = b := by ring
  have h3 : b - 1 + (a - 1) * b = 0 := by
    calc
      _ = a * b - 1 := by ring
      _ = 0 := by rw [hab, sub_self]
  have hji : Not (j = i) := Ne.symm hij
  apply Matrix.ext
  intro k l
  by_cases hki : k = i
  . subst k
    rw [Matrix.transvection_mul_apply_same i j l,
      Matrix.transvection_mul_apply_of_ne j i i l hij,
      Matrix.transvection_mul_apply_same j i l,
      Matrix.transvection_mul_apply_same i j l,
      Matrix.transvection_mul_apply_of_ne i j j l hji, one_mul]
    by_cases hli : l = i
    . subst l
      simp [Matrix.transvection, Matrix.single, hji, h1]
    . by_cases hlj : l = j
      . subst l
        simp [Matrix.transvection, Matrix.single, hij, hji, h2, h3]
      . simp [Matrix.transvection, Matrix.single, Ne.symm hli, Ne.symm hlj, hji]
  . by_cases hkj : k = j
    . subst k
      rw [Matrix.transvection_mul_apply_of_ne i j j l hji,
        Matrix.transvection_mul_apply_same j i l,
        Matrix.transvection_mul_apply_of_ne i j j l hji,
        Matrix.transvection_mul_apply_same i j l, one_mul]
      by_cases hli : l = i
      . subst l
        simp [Matrix.transvection, Matrix.single, hji, h1]
      . by_cases hlj : l = j
        . subst l
          simp [Matrix.transvection, Matrix.single, hij, hji, h2]
        . simp [Matrix.transvection, Matrix.single, Ne.symm hli, Ne.symm hlj, hji]
    . rw [Matrix.transvection_mul_apply_of_ne i j k l hki,
        Matrix.transvection_mul_apply_of_ne j i k l hkj,
        Matrix.transvection_mul_apply_of_ne i j k l hki]
      by_cases hkl : k = l
      . subst l
        simp [Matrix.transvection, Matrix.single, hki, hkj, Ne.symm hkj]
      . simp [Matrix.transvection, Matrix.single, hkl, Ne.symm hkj]

section Field

variable {F : Type*} [Field F] [Nontrivial I]

/-- Over a field, a subgroup containing the elementary row operations
contains every determinant-one matrix. -/
theorem specialLinear_mem_of_transvections
    (H : Subgroup (Matrix.SpecialLinearGroup I F))
    (hTrans : forall (i j : I) (hij : Not (i = j)) (a : F),
      Membership.mem H (Matrix.SpecialLinearGroup.transvection hij a))
    (g : Matrix.SpecialLinearGroup I F) : Membership.mem H g := by
  apply Matrix.SpecialLinearGroup.diagonal_transvection_induction'
    (fun x => Membership.mem H x) g
  . intro i j hij a ha
    have hab : a * Inv.inv a = 1 := by simpa only [div_eq_mul_inv] using div_self ha
    have hji : Not (j = i) := Ne.symm hij
    have hEq : Matrix.SpecialLinearGroup.diag2n hij a ha =
        Matrix.SpecialLinearGroup.transvection hij (a - 1) *
          (Matrix.SpecialLinearGroup.transvection hji 1 *
            (Matrix.SpecialLinearGroup.transvection hij (Inv.inv a - 1) *
              Matrix.SpecialLinearGroup.transvection hji (-a))) := by
      apply Subtype.ext
      exact diagonal_pair_eq_transvections i j hij a (Inv.inv a) hab
    rw [hEq]
    exact H.mul_mem (hTrans i j hij (a - 1)) (H.mul_mem (hTrans j i hji 1)
      (H.mul_mem (hTrans i j hij (Inv.inv a - 1)) (hTrans j i hji (-a))))
  . exact hTrans
  . intro A B hA hB
    exact H.mul_mem hA hB

end Field

end Robin1984.GRH

open IsDedekindDomain NumberField

namespace Robin1984.GRH

variable (K : Type*) [Field K] [NumberField K]

local notation "FA" => FiniteAdeleRing (RingOfIntegers K) K

/-- Every finite adelic neighborhood contains a diagonal field element.
Use a principal integral modulus inside the neighborhood translated to zero
and approximate the given adele modulo that principal modulus. -/
theorem denseRange_algebraMap_finiteAdeles :
    DenseRange (algebraMap K FA) := by
  intro a
  apply mem_closure_iff.mpr
  intro U hU ha
  let V := Set.preimage (fun y : FA => a - y) U
  have hV : IsOpen V := hU.preimage (continuous_const.sub continuous_id)
  have hV0 : Membership.mem V 0 := by
    change Membership.mem U (a - 0)
    rwa [sub_zero]
  choose d hd hSub using exists_scaledIntegralFiniteAdeles_subset_neighborhood K V hV hV0
  let e := algebraMap (RingOfIntegers K) K
  have hde : Not (e d = 0) :=
    (map_ne_zero_iff e (FaithfulSMul.algebraMap_injective (RingOfIntegers K) K)).mpr hd
  choose x hx using exists_finiteAdele_sub_principal_modulus (K := K) a (e d) hde
  let : MeasurableSpace FA := borel FA
  let : BorelSpace FA := BorelSpace.mk rfl
  have hMem : Membership.mem (heckeScaledIntegralFiniteAdeles (e d))
      (a - algebraMap K FA x) :=
    (mem_heckeScaledIntegralFiniteAdeles_iff (K := K) (e d) hde _).mpr hx
  have hUlt : Membership.mem U (algebraMap K FA x) := by
    have hu := hSub hMem
    change Membership.mem U (a - (a - algebraMap K FA x)) at hu
    simpa only [sub_sub_cancel] using hu
  exact Exists.intro (algebraMap K FA x) (And.intro hUlt (Set.mem_range_self x))

section Transvections

variable (n : Nat)

local notation "GL" => Matrix.GeneralLinearGroup (Fin n) FA

private def matrixTransvectionUnit {R : Type*} [CommRing R] {i j : Fin n}
    (hij : Not (i = j)) (x : R) : Matrix.GeneralLinearGroup (Fin n) R where
  val := Matrix.transvection i j x
  inv := Matrix.transvection i j (-x)
  val_inv := by rw [Matrix.transvection_mul_transvection_same i j hij, add_neg_cancel,
    Matrix.transvection_zero]
  inv_val := by rw [Matrix.transvection_mul_transvection_same i j hij, neg_add_cancel,
    Matrix.transvection_zero]

private theorem map_matrixTransvectionUnit {R S : Type*} [CommRing R] [CommRing S]
    (f : RingHom R S) {i j : Fin n} (hij : Not (i = j)) (x : R) :
    Units.map f.mapMatrix.toMonoidHom (matrixTransvectionUnit n hij x) =
      matrixTransvectionUnit n hij (f x) := by
  apply Units.ext
  change f.mapMatrix (Matrix.transvection i j x) = Matrix.transvection i j (f x)
  rw [Matrix.transvection, Matrix.transvection, map_add, map_one]
  congr 1
  apply Matrix.ext
  intro a b
  change f (Matrix.single i j x a b) = Matrix.single i j (f x) a b
  by_cases ha : i = a
  . by_cases hb : j = b <;> simp [Matrix.single, ha, hb]
  . simp [Matrix.single, ha]

private theorem continuous_finiteAdelicTransvection {i j : Fin n} (hij : Not (i = j)) :
    Continuous (fun x : FA => matrixTransvectionUnit n hij x) := by
  have hVal : Continuous (fun x : FA => Matrix.transvection i j x) := by
    apply continuous_pi
    intro a
    apply continuous_pi
    intro b
    change Continuous (fun x : FA =>
      (1 : Matrix (Fin n) (Fin n) FA) a b + Matrix.single i j x a b)
    apply continuous_const.add
    by_cases ha : i = a
    . by_cases hb : j = b
      . have hEq : (fun x : FA => Matrix.single i j x a b) = id := by
          funext x
          simp [Matrix.single, ha, hb]
        rw [hEq]
        exact continuous_id
      . simpa [Matrix.single, ha, hb] using (continuous_const : Continuous (fun _ : FA => (0 : FA)))
    . simpa [Matrix.single, ha] using (continuous_const : Continuous (fun _ : FA => (0 : FA)))
  exact Units.continuous_iff.mpr (And.intro hVal (hVal.comp continuous_neg))

/-- An elementary matrix over the finite adeles is in the closure of the
diagonal determinant-one group. -/
theorem finiteAdelicTransvection_mem_closure_principalDetOne
    {i j : Fin n} (hij : Not (i = j)) (x : FA) :
    let principal : MonoidHom (Matrix.GeneralLinearGroup (Fin n) K) GL :=
      Units.map (RingHom.mapMatrix (algebraMap K FA)).toMonoidHom
    let rational : Subgroup GL := (MonoidHom.ker (Matrix.GeneralLinearGroup.det
      (n := Fin n) (R := K))).map principal
    Membership.mem (closure (rational : Set GL)) (matrixTransvectionUnit n hij x) := by
  intro principal rational
  let E := fun y : FA => matrixTransvectionUnit n hij y
  let C := closure (rational : Set GL)
  have hc : IsClosed (Set.preimage E C) :=
    isClosed_closure.preimage (continuous_finiteAdelicTransvection K n hij)
  have hr : Set.Subset (Set.range (algebraMap K FA)) (Set.preimage E C) := by
    intro y hy
    choose t ht using hy
    rw [<- ht]
    apply subset_closure
    let g : Matrix.GeneralLinearGroup (Fin n) K := matrixTransvectionUnit n hij t
    refine Exists.intro g (And.intro ?_ ?_)
    . change Matrix.GeneralLinearGroup.det g = 1
      apply Units.ext
      exact Matrix.det_transvection_of_ne i j hij t
    . exact map_matrixTransvectionUnit n (algebraMap K FA) hij t
  exact closure_minimal hr hc (denseRange_algebraMap_finiteAdeles K x)

end Transvections

section Reduction

open scoped Classical

variable (n : Nat)

local notation "P" => HeightOneSpectrum (RingOfIntegers K)
local notation "GL" => Matrix.GeneralLinearGroup (Fin (n + 2)) FA
private abbrev ReductionLocalMatrixUnit (p : P) :=
  Matrix.GeneralLinearGroup (Fin (n + 2)) (p.adicCompletion K)

private noncomputable def finiteAdeleScalarSingle (p : P) (x : p.adicCompletion K) : FA := by
  refine Subtype.mk (Pi.single p x) ?_
  filter_upwards [Filter.eventually_cofinite_ne p] with q hq
  change Membership.mem (q.adicCompletionIntegers K) (Pi.single p x q)
  rw [Pi.single_eq_of_ne hq]
  exact (q.adicCompletionIntegers K).zero_mem

private theorem finiteAdeleMatrixUnit_ext {g h : GL}
    (he : forall p : P, Units.map (finiteAdeleMatrixEval K (n + 2) p).toMonoidHom g =
      Units.map (finiteAdeleMatrixEval K (n + 2) p).toMonoidHom h) : g = h := by
  apply Units.ext
  apply Matrix.ext
  intro i j
  apply FiniteAdeleRing.ext
  intro p
  exact congrArg (fun x : ReductionLocalMatrixUnit K n p => x.val i j) (he p)

/-- Every finite adelic matrix with determinant one has a rational
determinant-one left translate in the integral matrix subgroup. -/
theorem exists_principalDetOne_left_translate_mem_integralFiniteAdeles
    (g : GL) (hg : Matrix.GeneralLinearGroup.det g = 1) :
    let principal : MonoidHom (Matrix.GeneralLinearGroup (Fin (n + 2)) K) GL :=
      Units.map (RingHom.mapMatrix (algebraMap K FA)).toMonoidHom
    exists q : Matrix.GeneralLinearGroup (Fin (n + 2)) K,
      And (Matrix.GeneralLinearGroup.det q = 1)
        (Membership.mem (integralFiniteAdeleMatrixGroup K (n + 2)) (Inv.inv (principal q) * g)) := by
  intro principal
  let I := integralFiniteAdeleMatrixGroup K (n + 2)
  let R := (MonoidHom.ker (Matrix.GeneralLinearGroup.det (n := Fin (n + 2))
    (R := K))).map principal
  let C := R.topologicalClosure
  have hEx : Membership.mem (Set.iUnion (fun E : Finset P =>
      Set.range (finiteAdeleMatrixHaarChartEmbedding K (n + 2) E))) g := by
    rw [iUnion_range_finiteAdeleMatrixHaarChartEmbedding]
    exact Set.mem_univ g
  choose S hS using Set.mem_iUnion.mp hEx
  choose w hw using hS
  let emb := finiteAdeleMatrixHaarChartEmbedding K (n + 2) S
  let front : MonoidHom (forall p : (S : Set P), ReductionLocalMatrixUnit K n p.val) GL :=
    emb.comp (MonoidHom.inl _ _)
  let a := front w.1
  let u := emb (Prod.mk 1 w.2)
  have haDet (p : (S : Set P)) : Matrix.GeneralLinearGroup.det (w.1 p) = 1 := by
    rw [<- finiteAdeleMatrixHaarChartEval_of_mem K (n + 2) S w p, hw]
    apply Units.ext
    let ev : RingHom FA (p.val.adicCompletion K) :=
      RestrictedProduct.evalRingHom (fun q : P => q.adicCompletion K) p.val
    change (ev.mapMatrix g.val).det = 1
    rw [<- RingHom.map_det, show g.val.det = 1 from congrArg Units.val hg, map_one]
  have hAt (p : (S : Set P)) : Membership.mem (C.comap front)
      (Pi.mulSingle p (w.1 p)) := by
    let sl := Matrix.SpecialLinearGroup.toGL (n := Fin (n + 2)) (R := p.val.adicCompletion K)
    let atPlace := front.comp ((MonoidHom.mulSingle (fun q : (S : Set P) => ReductionLocalMatrixUnit K n q.val) p).comp sl)
    let Hp := C.comap atPlace
    have hT (i j : Fin (n + 2)) (hij : Not (i = j)) (z : p.val.adicCompletion K) :
        Membership.mem Hp (Matrix.SpecialLinearGroup.transvection hij z) := by
      let v := finiteAdeleScalarSingle K p.val z
      have hv : atPlace (Matrix.SpecialLinearGroup.transvection hij z) =
          matrixTransvectionUnit (n + 2) hij v := by
        apply finiteAdeleMatrixUnit_ext K n
        intro q
        let ev : RingHom FA (q.adicCompletion K) :=
          RestrictedProduct.evalRingHom (fun r : P => r.adicCompletion K) q
        let packet : FiniteAdeleMatrixHaarChart K (n + 2) S :=
          Prod.mk (Pi.mulSingle p (sl (Matrix.SpecialLinearGroup.transvection hij z))) 1
        change Units.map (finiteAdeleMatrixEval K (n + 2) q).toMonoidHom
          (finiteAdeleMatrixHaarChartEmbedding K (n + 2) S packet) =
            Units.map ev.mapMatrix.toMonoidHom (matrixTransvectionUnit (n + 2) hij v)
        rw [map_matrixTransvectionUnit]
        by_cases hq : Membership.mem (S : Set P) q
        . have he : Units.map (finiteAdeleMatrixEval K (n + 2) q).toMonoidHom
                (finiteAdeleMatrixHaarChartEmbedding K (n + 2) S packet) =
              packet.1 (Subtype.mk q hq) :=
            finiteAdeleMatrixHaarChartEval_of_mem K (n + 2) S packet (Subtype.mk q hq)
          rw [he]
          change (Pi.mulSingle p (sl (Matrix.SpecialLinearGroup.transvection hij z)) :
            forall x : (S : Set P), ReductionLocalMatrixUnit K n x.val) (Subtype.mk q hq) =
              matrixTransvectionUnit (n + 2) hij (ev v)
          by_cases hqp : q = p.val
          . subst q
            change (Pi.mulSingle p (sl (Matrix.SpecialLinearGroup.transvection hij z)) :
              forall x : (S : Set P), ReductionLocalMatrixUnit K n x.val) p =
                matrixTransvectionUnit (n + 2) hij (ev v)
            rw [Pi.mulSingle_eq_same]
            have hev : ev v = z := by
              change Pi.single p.val z p.val = z
              simp
            rw [hev]
            apply Units.ext
            rfl
          . have hn : Not ((Subtype.mk q hq : (S : Set P)) = p) :=
              fun h => hqp (congrArg Subtype.val h)
            rw [Pi.mulSingle_eq_of_ne hn]
            have hev : ev v = 0 := by
              change Pi.single p.val z q = 0
              exact Pi.single_eq_of_ne hqp z
            rw [hev]
            apply Units.ext
            exact (Matrix.transvection_zero i j).symm
        . have he : Units.map (finiteAdeleMatrixEval K (n + 2) q).toMonoidHom
                (finiteAdeleMatrixHaarChartEmbedding K (n + 2) S packet) =
              (1 : ReductionLocalMatrixUnit K n q) :=
            finiteAdeleMatrixHaarChartEval_of_notMem K (n + 2) S packet (Subtype.mk q hq)
          rw [he]
          have hqp : Not (q = p.val) := fun h => hq (Eq.mp (congrArg (fun t => Membership.mem (S : Set P) t) h.symm) p.property)
          have hev : ev v = 0 := by
            change Pi.single p.val z q = 0
            exact Pi.single_eq_of_ne hqp z
          rw [hev]
          apply Units.ext
          exact (Matrix.transvection_zero i j).symm
      change Membership.mem C (atPlace (Matrix.SpecialLinearGroup.transvection hij z))
      rw [hv]
      exact finiteAdelicTransvection_mem_closure_principalDetOne K (n + 2) hij v
    let wsl : Matrix.SpecialLinearGroup (Fin (n + 2)) (p.val.adicCompletion K) :=
      Subtype.mk (w.1 p).val (congrArg Units.val (haDet p))
    have hwsl : sl wsl = w.1 p := Units.ext rfl
    have hMem := specialLinear_mem_of_transvections Hp hT wsl
    change Membership.mem C (front (Pi.mulSingle p (sl wsl))) at hMem
    rw [hwsl] at hMem
    exact hMem
  have ha : Membership.mem C a := Subgroup.pi_mem_of_mulSingle_mem w.1 hAt
  have hu : Membership.mem I u := by
    apply (mem_integralFiniteAdeleMatrixGroup_iff_forall_local K (n + 2) u).mpr
    intro p
    change Membership.mem (finiteLocalMatrixUnitSubgroup K (n + 2) p)
      (Units.map (finiteAdeleMatrixEval K (n + 2) p).toMonoidHom
        (finiteAdeleMatrixHaarChartEmbedding K (n + 2) S (Prod.mk 1 w.2)))
    by_cases hp : Membership.mem (S : Set P) p
    . have he : Units.map (finiteAdeleMatrixEval K (n + 2) p).toMonoidHom
            (finiteAdeleMatrixHaarChartEmbedding K (n + 2) S (Prod.mk 1 w.2)) =
            (1 : ReductionLocalMatrixUnit K n p) :=
        finiteAdeleMatrixHaarChartEval_of_mem K (n + 2) S (Prod.mk 1 w.2) (Subtype.mk p hp)
      rw [he]
      exact Subgroup.one_mem _
    . have he : Units.map (finiteAdeleMatrixEval K (n + 2) p).toMonoidHom
            (finiteAdeleMatrixHaarChartEmbedding K (n + 2) S (Prod.mk 1 w.2)) =
            (w.2 (Subtype.mk p hp)).val :=
        finiteAdeleMatrixHaarChartEval_of_notMem K (n + 2) S (Prod.mk 1 w.2) (Subtype.mk p hp)
      rw [he]
      exact (w.2 (Subtype.mk p hp)).property
  have hFactor : a * u = g := by
    change emb (Prod.mk w.1 1) * emb (Prod.mk 1 w.2) = g
    rw [<- map_mul]
    rw [show (Prod.mk w.1 1 : FiniteAdeleMatrixHaarChart K (n + 2) S) *
      (Prod.mk 1 w.2) = w from Prod.ext (mul_one _) (one_mul _)]
    exact hw
  have hOpen : IsOpen (I : Set GL) := by
    have hEq : (I : Set GL) =
        Set.range (finiteAdeleMatrixHaarChartEmbedding K (n + 2) (Finset.empty : Finset P)) := by
      apply Set.ext
      intro x
      rw [mem_range_finiteAdeleMatrixHaarChartEmbedding_iff]
      constructor
      . intro h p _
        exact (mem_integralFiniteAdeleMatrixGroup_iff_forall_local K (n + 2) x).mp h p
      . intro h
        apply (mem_integralFiniteAdeleMatrixGroup_iff_forall_local K (n + 2) x).mpr
        intro p
        exact h p (Finset.notMem_empty p)
    rw [hEq]
    exact (isOpenEmbedding_finiteAdeleMatrixHaarChartEmbedding K (n + 2) Finset.empty).isOpen_range
  let V := Set.preimage (fun x : GL => Inv.inv x * a) (I : Set GL)
  have hV : IsOpen V := hOpen.preimage (continuous_inv.mul continuous_const)
  have hVa : Membership.mem V a := by
    change Membership.mem I (Inv.inv a * a)
    rw [inv_mul_cancel]
    exact Subgroup.one_mem _
  have hClose : Membership.mem (closure (R : Set GL)) a := ha
  choose r hr using (mem_closure_iff.mp hClose) V hV hVa
  have hrR : Membership.mem R r := hr.2
  choose q hq using hrR
  refine Exists.intro q (And.intro hq.1 ?_)
  have hrV : Membership.mem I (Inv.inv r * a) := hr.1
  rw [hq.2, <- hFactor, <- mul_assoc]
  exact I.mul_mem hrV hu

end Reduction

section DeterminantFiber

variable (n : Nat)

local notation "Idx" => Fin (n + 2)
local notation "GL" => Matrix.GeneralLinearGroup Idx FA

private def matrixFirstDiagonalUnit {R : Type*} [CommRing R] :
    MonoidHom (Units R) (Matrix.GeneralLinearGroup Idx R) :=
  Units.map ((Matrix.diagonalRingHom Idx R).toMonoidHom.comp
    (MonoidHom.mulSingle (fun _ : Idx => R) (0 : Idx)))

private theorem det_matrixFirstDiagonalUnit {R : Type*} [CommRing R] (x : Units R) :
    Matrix.GeneralLinearGroup.det (matrixFirstDiagonalUnit n x) = x := by
  apply Units.ext
  change (Matrix.diagonal (Pi.mulSingle (0 : Idx) x.val)).det = x.val
  rw [Matrix.det_diagonal]
  simp [Pi.mulSingle_apply]

private theorem continuous_finiteAdeleFirstDiagonalUnit :
    Continuous (matrixFirstDiagonalUnit n : Units FA -> GL) := by
  have hDiag : Continuous (fun x : FA => Matrix.diagonal ((Pi.mulSingle (0 : Idx) x : Idx -> FA))) := by
    apply continuous_pi
    intro i
    apply continuous_pi
    intro j
    by_cases h : i = j
    . subst j
      have heq : (fun x : FA => Matrix.diagonal ((Pi.mulSingle (0 : Idx) x : Idx -> FA)) i i) =
          (fun x => (Pi.mulSingle (0 : Idx) x : Idx -> FA) i) :=
        funext (fun x => Matrix.diagonal_apply_eq (Pi.mulSingle (0 : Idx) x : Idx -> FA) i)
      rw [heq]
      by_cases hi : i = 0
      . subst i
        have hid : (fun x : FA => (Pi.mulSingle (0 : Idx) x : Idx -> FA) 0) = id := by
          funext x
          simp
        rw [hid]
        exact continuous_id
      . have hone : (fun x : FA => (Pi.mulSingle (0 : Idx) x : Idx -> FA) i) = (fun _ => 1) :=
          funext (fun x => by simp [hi])
        rw [hone]
        exact continuous_const
    . have hzero : (fun x : FA => Matrix.diagonal ((Pi.mulSingle (0 : Idx) x : Idx -> FA)) i j) =
          (fun _ => 0) := funext (fun x => Matrix.diagonal_apply_ne _ h)
      rw [hzero]
      exact continuous_const
  exact Units.continuous_iff.mpr
    (And.intro (hDiag.comp Units.continuous_val)
      (hDiag.comp (Units.continuous_val.comp continuous_inv)))

/-- A compact set of finite adelic determinants gives a compact set of
matrix representatives modulo left translation by the rational
determinant-one group. -/
theorem exists_compact_finiteAdelicMatrixRepresentatives_of_compactDeterminants
    (B : Set (Units FA)) (hB : IsCompact B) :
    let principal : MonoidHom (Matrix.GeneralLinearGroup Idx K) GL :=
      Units.map (RingHom.mapMatrix (algebraMap K FA)).toMonoidHom
    exists C : Set GL, And (IsCompact C)
      (forall g : GL, Membership.mem B (Matrix.GeneralLinearGroup.det g) ->
        exists q : Matrix.GeneralLinearGroup Idx K, And (Matrix.GeneralLinearGroup.det q = 1)
          (Membership.mem C (Inv.inv (principal q) * g))) := by
  intro principal
  let T := matrixFirstDiagonalUnit n (R := FA)
  let I := integralFiniteAdeleMatrixGroup K (n + 2)
  let m (p : Prod GL GL) := p.1 * p.2
  let C := Set.image m (Set.prod (I : Set GL) (Set.image T B))
  have hI : IsCompact (I : Set GL) := isCompact_integralFiniteAdeleMatrixGroup K (n + 2)
  have hT : IsCompact (Set.image T B) := hB.image (continuous_finiteAdeleFirstDiagonalUnit K n)
  refine Exists.intro C (And.intro ((hI.prod hT).image (continuous_fst.mul continuous_snd)) ?_)
  intro g hg
  let h := g * Inv.inv (T (Matrix.GeneralLinearGroup.det g))
  have hd : Matrix.GeneralLinearGroup.det h = 1 := by
    change Matrix.GeneralLinearGroup.det (g * Inv.inv (T (Matrix.GeneralLinearGroup.det g))) = 1
    rw [map_mul, map_inv, det_matrixFirstDiagonalUnit, mul_inv_cancel]
  choose q hq using exists_principalDetOne_left_translate_mem_integralFiniteAdeles K n h hd
  refine Exists.intro q (And.intro hq.1 ?_)
  refine Exists.intro (Prod.mk (Inv.inv (principal q) * h) (T (Matrix.GeneralLinearGroup.det g)))
    (And.intro (And.intro hq.2 (Set.mem_image_of_mem T hg)) ?_)
  change (Inv.inv (principal q) * (g * Inv.inv (T (Matrix.GeneralLinearGroup.det g)))) *
    T (Matrix.GeneralLinearGroup.det g) = Inv.inv (principal q) * g
  rw [mul_assoc, mul_assoc g, inv_mul_cancel, mul_one]

end DeterminantFiber

section NormOneProjections

variable (n : Nat)

local notation "Idx" => Fin (n + 2)
local notation "GL" => Matrix.GeneralLinearGroup Idx FA
local notation "G" => AdelicGeneralLinearGroup K (n + 2)
local notation "N" => MonoidHom.ker (adelicDeterminantLogNorm K (n + 2))
local notation "H" => heckeNormOneIdeles K
local notation "PA" => AdeleRing (RingOfIntegers K) K
local notation "IA" => InfiniteAdeleRing K

/-- Every rational orbit in the determinant-norm-one adelic group meets
the inverse image of a fixed compact set of finite adelic matrices.
The determinant is reduced in the compact norm-one idele class group
before applying determinant-one approximation in the finite matrices. -/
theorem exists_compact_finite_projection_orbitCover :
    exists C : Set GL, And (IsCompact C) (forall A : N,
      exists q : Matrix.GeneralLinearGroup Idx K,
        Membership.mem C ((adelicGeneralLinearGroup_prod K (n + 2)
          ((adelicPrincipalDeterminantOne K (n + 2) q) * A).val).2)) := by
  let d : MonoidHom N H :=
    (Matrix.GeneralLinearGroup.det.comp (adelicDeterminantLogNorm K (n + 2)).ker.subtype).codRestrict
      H (fun x => by
        apply (mem_heckeNormOneIdeles K _).mpr
        have hx : Real.log (adelicDeterminantNorm K (n + 2) x.val) = 0 := x.property
        change adelicDeterminantNorm K (n + 2) x.val = 1
        rw [<- Real.exp_log (adelicDeterminantNorm_pos K (n + 2) x.val), hx, Real.exp_zero])
  let proj : MonoidHom H (Units FA) :=
    (Units.map (RingHom.snd IA FA).toMonoidHom).comp (heckeNormOneIdeles K).subtype
  let split : Homeomorph (Units PA) (Prod (Units IA) (Units FA)) := Homeomorph.prodUnits
  have hProj : Continuous proj :=
    continuous_snd.comp (split.continuous.comp continuous_subtype_val)
  let phi : MonoidHom G GL :=
    (MonoidHom.snd _ _).comp (adelicGeneralLinearGroup_prod K (n + 2)).toMulEquiv.toMonoidHom
  have hDet (A : N) : proj (d A) = Matrix.GeneralLinearGroup.det (phi A.val) := by
    apply Units.ext
    exact RingHom.map_det (RingHom.snd IA FA) A.val.val
  have hPrincipal (q : Matrix.GeneralLinearGroup Idx K) :
      phi (adelicPrincipalDeterminantOne K (n + 2) q).val =
        Units.map (RingHom.mapMatrix (algebraMap K FA)).toMonoidHom q :=
    Units.ext rfl
  let P := heckePrincipalNormOneIdele K
  let Q := QuotientGroup.mk' P.range
  choose D hD using exists_compact_heckeNormOneIdeleRepresentatives K
  let B := Set.image proj D
  choose C hC using exists_compact_finiteAdelicMatrixRepresentatives_of_compactDeterminants
    K n B (hD.1.image hProj)
  refine Exists.intro C (And.intro hC.1 ?_)
  intro A
  have hA : Membership.mem (Set.image Q D) (Q (d A)) := by
    change Membership.mem (Set.image (QuotientGroup.mk' (heckePrincipalNormOneIdele K).range) D) (Q (d A))
    rw [hD.2]
    exact Set.mem_univ _
  choose z hz using hA
  have hQ : Q (z * Inv.inv (d A)) = 1 := by
    rw [map_mul, map_inv, hz.2, mul_inv_cancel]
  choose a ha using (QuotientGroup.eq_one_iff (z * Inv.inv (d A))).mp hQ
  change P a = z * Inv.inv (d A) at ha
  have hZ : P a * d A = z := by rw [ha, mul_assoc, inv_mul_cancel, mul_one]
  let h := matrixFirstDiagonalUnit n a
  let A1 := adelicPrincipalDeterminantOne K (n + 2) h * A
  have hD0 : d (adelicPrincipalDeterminantOne K (n + 2) h) = P a := by
    apply Subtype.ext
    change Matrix.GeneralLinearGroup.det (Matrix.GeneralLinearGroup.map (algebraMap K PA) h) =
      Units.map (algebraMap K PA).toMonoidHom a
    rw [Matrix.GeneralLinearGroup.map_det, det_matrixFirstDiagonalUnit]
    exact Units.ext rfl
  have hDA1 : d A1 = z := by
    change d (adelicPrincipalDeterminantOne K (n + 2) h * A) = z
    rw [map_mul, hD0, hZ]
  have hMem : Membership.mem B (Matrix.GeneralLinearGroup.det (phi A1.val)) := by
    rw [<- hDet A1, hDA1]
    exact Set.mem_image_of_mem proj hz.1
  choose q hq using hC.2 (phi A1.val) hMem
  refine Exists.intro (Inv.inv q * h) ?_
  change Membership.mem C (phi ((adelicPrincipalDeterminantOne K (n + 2) (Inv.inv q * h) * A).val))
  rw [show adelicPrincipalDeterminantOne K (n + 2) (Inv.inv q * h) =
    Inv.inv (adelicPrincipalDeterminantOne K (n + 2) q) *
      adelicPrincipalDeterminantOne K (n + 2) h by rw [map_mul, map_inv], mul_assoc]
  change Membership.mem C (phi ((Inv.inv (adelicPrincipalDeterminantOne K (n + 2) q)).val * A1.val))
  rw [map_mul, show (Inv.inv (adelicPrincipalDeterminantOne K (n + 2) q)).val =
    Inv.inv (adelicPrincipalDeterminantOne K (n + 2) q).val from rfl, map_inv, hPrincipal]
  exact hq.2

end NormOneProjections

end Robin1984.GRH
